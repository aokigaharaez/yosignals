BOT_TOKEN=
OWNER_TELEGRAM_ID=
OWNER_TELEGRAM_IDS=
TIMEZONE=Europe/Simferopol
DB_PATH=signals.db

# Signal Lab / Mini App settings
WEBAPP_URL=https://endearing-intuition-production-a1a9.up.railway.app/
LOCAL_PREVIEW=false
BOT_ENABLED=true
TWELVE_DATA_API_KEY=
# Live quotes through one server WebSocket; requires access for selected symbols
TWELVE_DATA_STREAM_ENABLED=true
MARKET_CACHE_SECONDS=60
MAX_DATA_AGE_SECONDS=90
MODEL_MIN_SCORE=0.60
MODEL_MIN_VALIDATION=0.54
AUTH_MAX_AGE_SECONDS=3600



# Optional GPT reviews (key stays on the server)
OPENAI_API_KEY=

# Forex feeds can publish closed bars later than crypto feeds
FOREX_MAX_DATA_AGE_SECONDS=180

# ML history, training and strict signal validation
MODEL_HISTORY_LIMIT=20000
CRYPTO_BACKFILL_CANDLES=10000
MODEL_RETRAIN_SECONDS=600
MODEL_TARGET_WIN_RATE=0.70
MODEL_MIN_CALIBRATION_SAMPLES=150
MODEL_MIN_TEST_SIGNALS=100

# EUR/USD and other forex pairs: history per Twelve Data request
FOREX_HISTORY_CANDLES=5000

# Initial EUR/USD historical bootstrap (up to three extra Twelve Data requests)
FOREX_BACKFILL_CANDLES=20000
