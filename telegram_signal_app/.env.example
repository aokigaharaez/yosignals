# Copy to .env. Never commit real credentials.
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
OWNER_TELEGRAM_ID=YOUR_TELEGRAM_ID
# Multiple IDs can be comma-separated in OWNER_TELEGRAM_ID, or set here.
# Additional owners can be managed in Mini App -> Access.
OWNER_TELEGRAM_IDS=
TIMEZONE=Europe/Simferopol
DB_PATH=signals.db
WEBAPP_URL=
HOST=127.0.0.1
PORT=8000
LOCAL_PREVIEW=true
BOT_ENABLED=true
TWELVE_DATA_API_KEY=
MARKET_CACHE_SECONDS=60
MAX_DATA_AGE_SECONDS=90
MODEL_MIN_SCORE=0.60
MODEL_MIN_VALIDATION=0.54
AUTH_MAX_AGE_SECONDS=3600


